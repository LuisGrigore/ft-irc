classDiagram
    class IRCService {
        <<orchestrator>>
        - ClientManager& clientManager
        + IRCService(ClientManager& clientManager)
        + ~IRCService()
        + void onConnect(int fd)
        + void onData(int fd, const std::string& data)
        + void onDisconnect(int fd)
    }

    class CommandDispatcher {
        <<dispatcher>>
        - CommandContext* context
        - CommandHandler* head
        + CommandDispatcher(ClientManager& clients, ChannelManager& channels, NickManager& nicks, const std::string& password, const std::string& serverName, std::set~int~& outputDirty, std::set~int~& closeRequests)
        + ~CommandDispatcher()
        + void setHandlerChain(CommandHandler* head)
        + bool dispatchNext(Client& client)
    }

    class IRCParser {
        <<utility>>
        + parseLine$(const std::string& line, IRCMessage& msg) bool
        + extractPrefix$(const std::string& line) std::string
        + extractCommand$(const std::string& line) std::string
        + extractParams$(const std::string& line, std::vector~std::string~& params, std::string& trailing) void
    }

    class IRCMessage {
        <<data>>
        + std::string prefix
        + std::string command
        + std::vector~std::string~ params
        + std::string trailing
        + std::string rawLine
    }

    class CommandFactory {
        <<factory>>
        + createCommand$(const std::string& name) Command*
        + registerCommand$(const std::string& name, CommandCreator creator) void
    }

    class CommandHandler {
        <<interface>>
        + ~CommandHandler()
        + handle(CommandContext& ctx, Client& client, const IRCMessage& msg, Command* cmd)* bool
        + void setNext(CommandHandler* next)
    }

    class RegistrationCheckHandler {
        <<chain>>
        + bool handle(...)
    }
    class ParamCheckHandler {
        <<chain>>
        + bool handle(...)
    }
    class ExecutionHandler {
        <<chain>>
        + bool handle(...)
    }

    class Command {
        <<interface>>
        + ~Command()
        + execute(CommandContext& ctx, Client& client, const IRCMessage& msg)* void
        + name() const* std::string
        + requiresRegistration() const* bool
        + minParams() const* size_t
    }

    class XxxCommand {
        <<command>>
        PASS NICK USER JOIN PART PRIVMSG NOTICE
        KICK INVITE TOPIC MODE QUIT PING CAP
        + void execute(CommandContext& ctx, Client& client, const IRCMessage& msg)
        + std::string name() const
        + bool requiresRegistration() const
        + size_t minParams() const
    }

