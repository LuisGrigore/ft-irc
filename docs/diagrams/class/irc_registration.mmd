classDiagram
    class IRCService {
        <<orchestrator>>
        - ClientManager& clientManager
        + IRCService(ClientManager& clientManager)
        + ~IRCService()
        + void onConnect(int fd)
        + void onData(int fd, const std::string& data)
        + void onDisconnect(int fd)
    }

    class Client {
        <<entity>>
        - int fd
        - std::string nick
        - std::string username
        - std::string realname
        - std::string hostname
        - bool authenticated
        - bool registered
        - bool closing
        - ClientBuffer inputBuffer
        - ClientBuffer outputBuffer
        + Client(int fd)
        + ~Client()
        + int getFd() const
        + const std::string& getNick() const
        + const std::string& getUsername() const
        + const std::string& getRealname() const
        + const std::string& getHostname() const
        + void setFd(int fd)
        + void setNick(const std::string& nick)
        + void setUsername(const std::string& username)
        + void setRealname(const std::string& realname)
        + void setHostname(const std::string& hostname)
        + void setAuthenticated(bool authenticated)
        + void setRegistered(bool registered)
        + void setClosing(bool closing)
        + bool isAuthenticated() const
        + bool isRegistered() const
        + bool isClosing() const
        + bool isInputBufferEmpty() const
        + bool isOutputBufferEmpty() const
        + void pushInput(const std::string& data)
        + void pushInput(char data)
        + void pushInput(const char* data)
        + bool getNextInputLine(std::string& line)
        + void pushOutput(const std::string& data)
        + void pushOutput(char data)
        + void pushOutput(const char* data)
        + std::string peekOutput(size_t length) const
        + void consumeOutput(size_t length)
    }

    class ClientBuffer {
        - std::string buffer
        + ClientBuffer()
        + ~ClientBuffer()
        + void push(const std::string& data)
        + void push(char data)
        + void push(const char* data)
        + std::string peek(size_t length) const
        + void consume(size_t length)
        + bool empty() const
        + size_t size() const
        + void clear()
    }

    class CommandDispatcher {
        <<dispatcher>>
        - CommandContext* context
        - CommandHandler* head
        + bool dispatchNext(Client& client)
    }

    class CommandHandler {
        <<interface>>
        + ~CommandHandler()
        + handle(CommandContext& ctx, Client& client, const IRCMessage& msg)* bool
        + void setNext(CommandHandler* next)
    }

    class RegistrationCheckHandler {
        <<chain>>
        + bool handle(...)
    }

    class CommandContext {
        <<context>>
        + ClientManager& clients
        + NickManager& nicks
        + const std::string& password
        + const std::string& serverName
        - std::set~int~& outputDirty
        - std::set~int~& closeRequests
        + void send(Client& to, const std::string& msg)
        + void disconnect(Client& client, const std::string& reason)
    }

    class IRCMessage {
        <<data>>
        + std::string prefix
        + std::string command
        + std::vector~std::string~ params
        + std::string trailing
        + std::string rawLine
    }

    class ClientManager {
        <<registry>>
        - std::map~int, Client*~ clients
        - std::set~int~ dirtyClients
        + ClientManager()
        + ~ClientManager()
        + Client* findClient(int fd)
        + Client* findClient(const std::string& nick)
        + void addClient(int fd)
        + void removeClient(int fd)
        + std::vector~Client*~ listClients() const
        + void setDirty(int fd, bool isDirty)
        + std::set~int~ getDirtyClients() const
        + bool isDirty(int fd) const
    }

    class NickManager {
        <<registry>>
        - std::set~std::string~ nicks
        - static const std::string::size_type NICK_MAX_LENGTH
        + NickManager()
        + ~NickManager()
        + bool isAvailable(const std::string& nick) const
        + bool reserve(const std::string& nick)
        + void release(const std::string& nick)
        + bool isValid(const std::string& nick) const
        - static bool isLetter(char c)
        - static bool isDigit(char c)
        - static bool isSpecial(char c)
        + static std::string normalize(const std::string& nick)
    }

    IRCService --> ClientManager : uses (reference)
    CommandDispatcher *-- CommandContext : owns
    CommandDispatcher o-- CommandHandler : chain head
    CommandHandler <|.. RegistrationCheckHandler
    CommandDispatcher --> IRCMessage : consumes
    IRCService ..> Client : authenticated / registered state
    CommandContext ..> Client : checks registration
    ClientManager --> Client : map of clients
    ClientManager ..> NickManager : nickname registry
    Client *-- ClientBuffer : input / output buffers
